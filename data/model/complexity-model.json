  "criterion": {
    "cpu_engine_step": "T_cpu = T_sched + T_rpc + T_prepare + T_launch_fwd + T_post",
    "step_time": "T_step >= max(T_cpu, T_dev)",
    "bottleneck_definition": "T_prepare > T_dev - (T_sched + T_rpc + T_launch_fwd + T_post) := B_cpu",
    "decode_crossover": {
      "model": "T_prepare ~ c_p + a*B ; T_dev ~ e + d*B ; T_cpu_other ~ c_o",
      "condition": "B > (e - c_p - c_o)/(a - d)，仅当 a > d",
      "regimes": {
        "slope_limited": "a > d：大 B 时占比上升",
        "floor_limited": "c_p + c_o > e：任何 B 都 CPU 受限",
        "hidden": "a < d 且 c_p + c_o < e：无吞吐收益"
      }
    },
    "chunked_crossover": {
      "model": "T_dev ~ e' + beta*T + gamma*T*(S+T/2) ; T_prepare ~ c_p + a_T*T",
      "solve": "c_p + a_T*T = e' + beta*T + gamma*T*(S+T/2) -> T_min",
      "note": "小 chunk 区 T_prepare 出现不随 T 下降的平台（高度 = c_p）"
    },
    "tp_straggler": "T_step = max_r T_cpu,r + T_dev + T_comm ; E[max] ~ mu + sigma*sqrt(2 ln R)",
    "async_off": "T_step ~ T_sched + T_rpc + T_prepare + T_dev + T_post + T_sample + T_sched_update（无掩盖）",
    "share_definitions": {
      "share_cpu": "T_prepare / T_cpu",
      "share_step": "T_prepare / T_step",
      "share_e2e": "端到端损失归因（仅 T_cpu > T_dev 时非零）"
    }
  },
